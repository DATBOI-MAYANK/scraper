{
  "name": "bigdata-collector-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Synchronizes BigData collector documents into MongoDB.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "sync": "tsx src/scripts/run-sync.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mongoose": "^8.13.2",
    "node-cron": "^4.0.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "eslint": "^9.24.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
  }
}
