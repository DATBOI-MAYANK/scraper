NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb-URI
BIGDATA_API_KEY=replace_me
BIGDATA_CONNECTOR_ID=replace_me
# Comma-separated local/production frontend URLs. Do not include a trailing slash.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# At least 16 random characters. Required to enable POST /api/sync.
SYNC_API_TOKEN=replace_with_a_long_random_secret
# Six fields: second minute hour day-of-month month day-of-week. Every Sunday at midnight:
SYNC_CRON=0 0 0 * * 0
# Retry transient upstream/database failures with exponential backoff.
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_BASE_DELAY_MS=1000
